{
  "name": "voc-copilot",
  "version": "1.0.0",
  "description": "Voice of Customer Copilot — Transform raw customer feedback into evidence-backed product insights",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon src/server/index.js",
    "dev:client": "vite --config vite.config.js",
    "seed": "node src/server/db/seed.js",
    "build": "vite build src/client"
  },
  "keywords": [
    "product-management",
    "customer-feedback",
    "ai",
    "gemini"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "papaparse": "^5.7.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "vite": "^8.3.4"
  }
}
